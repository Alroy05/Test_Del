    DOC_EVENT = 3
    EMAIL_EVENT = 4
    INTAKE_EVENT = 5
    DATE_EVENT = 6
    RESP_EVENT = 7
    ANALYZE_EVENT = 8
    SEC_ANALYZE_EVENT = 9
    ARTIFACT_EVENT = 10
    AI_EVENT = 11
    ATO_STATUS_EVENT = 12
    SAR_LOG_EVENT = 13
    FINDINGS_EVENT = 14
    ADO_EVENT = 15
    RESET_INTAKE_EVENT = 16
    RESET_REVIEW_EVENT = 17
    CHANGE_SOLUTION_TYPE_EVENT = 18
    RES_ASS_EVENT = 19

    RES_FOR_ASSESSMENT = "assessment_status"
    RES_FOR_REQUEST = "request_status"
    RES_FOR_SUB_STATUS = "request_sub_status"
    RES_FOR_CLEARANCE_COMMENT = "Clearance comment"
    RES_FOR_CLEARANCE_DOC = "Clearance document"
    RES_FOR_REQUEST_COMMENT = "SAR request comment"
    RES_FOR_DELETE_FINDINGS = "Delete findings"
    RES_FOR_AI_SKIP = "Skip AI Evaluation"

    REV_REASON_TYPE_ENV = 1
    REV_REASON_TYPE_LACK = 2
    REV_REASON_TYPE_REM = 3
    REV_REASON_TYPE_REQ = 4
    REV_REASON_TYPE_OTHER = 5

    EVENT_TYPE_CHOICES = {
        STATUS_EVENT: "Status",
        COMMENTS_EVENT: "Comment",
        DOC_EVENT: "Artifacts",
        EMAIL_EVENT: "Email",
        INTAKE_EVENT: "Intake form data",
        DATE_EVENT: "Date change",
        RESP_EVENT: "Response provided",
        ANALYZE_EVENT: "Coordinator Comments",
        SEC_ANALYZE_EVENT: "Security Resource Comments",
        ARTIFACT_EVENT: "Checklist Update",
        AI_EVENT: "AI",
        ATO_STATUS_EVENT: "ATO Status Event",
        FINDINGS_EVENT: "Findings",
        ADO_EVENT: "ADO",
        RESET_INTAKE_EVENT: "Reset Intake",
        RESET_REVIEW_EVENT: "Reset Review",
        CHANGE_SOLUTION_TYPE_EVENT: "Change Solution Type",
        RES_ASS_EVENT: "Re-initiate Assessment"
    }

    REV_GO_LIVE_REASON_CHOICES = {
        REV_REASON_TYPE_ENV: "Environment not ready",
        REV_REASON_TYPE_LACK: "Lack of response",
        REV_REASON_TYPE_REM: "Remediation Efforts/Retest",
        REV_REASON_TYPE_REQ: "Required/Missing documentation",
        REV_REASON_TYPE_OTHER: "Other",
    }

    id = models.AutoField(primary_key=True)
    request = models.ForeignKey(
        RequestorTeam, on_delete=models.CASCADE, db_column="sgp_id", related_name="logs"
    )
    event = models.IntegerField()
    old_value = models.TextField(null=True, blank=True)
    new_value = models.TextField(null=True, blank=True)
    response_for = models.CharField(max_length=255)
    user_role = models.CharField(max_length=25, null=True, blank=True)
    created_by = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.PROTECT,
        db_column="created_by",
        to_field="id",
    )
    created_date = models.DateTimeField(auto_now_add=True)

    class Meta:
        db_table = "log_update"
        ordering = ["-created_date"]
        indexes = [
            models.Index(
                fields=[
                    "request",
                    "event",
                    "created_date",
                ],
                name="log_timeline_idx",
            ),
        ]

    @classmethod
    def get_event_type_display(cls, event_id):
        return cls.EVENT_TYPE_CHOICES.get(event_id, "-")

    @classmethod
    def get_rev_go_live_reason_display(cls, reason_id):
        return cls.REV_GO_LIVE_REASON_CHOICES.get(reason_id, "-")

    def get_event_type_as_string(self):
        return self.EVENT_TYPE_CHOICES.get(self.event, "Unknown")

    def log_update_user(self):
        return self.created_by

    @property
    def event_string(self):
        return self.get_event_type_as_string()

    @property
    def created_by_name(self):
        if (
            self.created_by
            and hasattr(self.created_by, "first_name")
            and hasattr(self.created_by, "last_name")
        ):
            return f"{self.created_by.first_name} {self.created_by.last_name}"
        return None

    @property
    def old_value_str(self):
        if self.event == self.STATUS_EVENT:
            if self.response_for == self.RES_FOR_REQUEST:
                status_str = RequestorTeam.get_status_as_string_by_id(self.old_value)  # type: ignore
                if status_str != "-":
                    return status_str
        return self.old_value

    @property
    def new_value_str(self):
        if self.event == self.STATUS_EVENT:
            if self.response_for == self.RES_FOR_REQUEST:
                status_str = RequestorTeam.get_status_as_string_by_id(self.new_value)  # type: ignore
                if status_str != "-":
                    return status_str
        return self.new_value


