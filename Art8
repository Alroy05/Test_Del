    def get_assigned_security_users(self):
        from django.contrib.auth import get_user_model

        UserModel = get_user_model()

        if not self.assigned_security_id:
            return UserModel.objects.none()

        ids = [
            uid.strip() for uid in self.assigned_security_id.split(",") if uid.strip()
        ]
        return UserModel.objects.filter(id__in=ids)

    def get_assigned_leadership_users(self):

        from django.contrib.auth import get_user_model

        UserModel = get_user_model()

        if not self.assigned_leadership_id:
            return UserModel.objects.none()

        ids = [
            uid.strip() for uid in self.assigned_leadership_id.split(",") if uid.strip()
        ]
        return UserModel.objects.filter(id__in=ids)

    def set_assigned_security_users(self, user_ids):
        from django.contrib.auth import get_user_model

        UserModel = get_user_model()

        if not user_ids:
            self.assigned_security_id = None
            self.assigned_security_name = None
            return

        clean_ids = [str(uid).strip() for uid in user_ids if str(uid).strip()]

        if not clean_ids:
            self.assigned_security_id = None
            self.assigned_security_name = None
            return

        user_map = {str(u.id): u for u in UserModel.objects.filter(id__in=clean_ids)}  # type: ignore

        resolved_ids = []
        resolved_names = []
        for uid in clean_ids:
            user = user_map.get(uid)
            if user:
                resolved_ids.append(str(user.id))  # type: ignore
                resolved_names.append(user.get_full_name())  # type: ignore

        self.assigned_security_id = ",".join(resolved_ids) or None
        self.assigned_security_name = ",".join(resolved_names) or None

    def set_assigned_leadership_users(self, user_ids):
        from django.contrib.auth import get_user_model

        UserModel = get_user_model()

        if not user_ids:
            self.assigned_leadership_id = None
            self.assigned_leadership_name = None
            return

        clean_ids = [str(uid).strip() for uid in user_ids if str(uid).strip()]
        if not clean_ids:
            self.assigned_leadership_id = None
            self.assigned_leadership_name = None
            return

        user_map = {str(u.id): u for u in UserModel.objects.filter(id__in=clean_ids)}  # type: ignore

        resolved_ids, resolved_names = [], []
        for uid in clean_ids:
            u = user_map.get(uid)
            if u:
                resolved_ids.append(str(u.id))  # type: ignore
                resolved_names.append(u.get_full_name())  # type: ignore

        self.assigned_leadership_id = ",".join(resolved_ids) or None
        self.assigned_leadership_name = ",".join(resolved_names) or None

from rest_framework import serializers

from app.models import LogUpdate


class LogUpdateSerializer(serializers.ModelSerializer):
    event_string = serializers.SerializerMethodField()
    created_by_name = serializers.CharField(
        source="created_by.get_full_name", read_only=True, default=""
    )
    old_value_str = serializers.SerializerMethodField()
    new_value_str = serializers.SerializerMethodField()
    created_date = serializers.DateTimeField(format="%Y-%m-%d %H:%M:%S", read_only=True)

    class Meta:
        model = LogUpdate
        fields = [
            "id",
            "event",
            "old_value",
            "new_value",
            "response_for",
            "created_date",
            "event_string",
            "created_by_name",
            "user_role",
            "old_value_str",
            "new_value_str",
        ]

    def get_event_string(self, obj):
        return obj.event_string

    def get_old_value_str(self, obj):
        return obj.old_value_str

    def get_new_value_str(self, obj):
        return obj.new_value_str




